    </ItemGroup>

    <ItemGroup>
      <Folder Include="Dtos\" />
    </ItemGroup>

   <ItemGroup>
      <Protobuf Include="..\Shared\Contracts\Protos\assistant.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
      <Protobuf Include="..\Shared\Contracts\Protos\embedding.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
      <Protobuf Include="..\Shared\Contracts\Protos\article.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
      <Protobuf Include="..\Shared\Contracts\Protos\document.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

</Project>
